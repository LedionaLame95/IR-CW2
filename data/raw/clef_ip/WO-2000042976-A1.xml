gory="Y" name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>FAITH CO LTD</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>KOJIMA TSUYOSHI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>NISHIOKA HAJIME</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>FAITH CO., LTD.</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>KOJIMA, TSUYOSHI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>NISHIOKA, HAJIME</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>NISHIOKA HAJIME</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>NISHIOKA, HAJIME</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>Cosmetics generating no active oxygen. These cosmetics are prepared by combining components (bases, antioxidants, humectants, neutralizing agents, thickeners, foaming agents, preservatives, refreshing agents, buffers, pH regulating agents, coloring matters, fillers, saponifying agents, dispersants, anti-inflammatory agents, emulsifiers, fats and oils, ultraviolet light absorbers, skin-conditioners, solubilizers, surfactants, astringents, moisturizers, emollients, ultraviolet light scattering agents or thickening aids) with one or more substances generating no active oxygen.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention concerne des produits cosmétiques ne générant pas d'oxygène actif. Ces produits sont préparés par la combinaison de composants (de bases, d'antioxydants, d'humectants, d'agents neutralisants, d'épaississants, d'agents moussants, d'agents conservateurs, d'agents de rafraîchissement, de tampons, d'agents régulateurs de pH, de substances colorantes, de charges, d'agents de saponification, d'agents de dispersion, d'agents anti-inflammatoires, d'émulsifiants, de graisses et d'huiles, d'agents absorbant la lumière ultraviolette, d'agents revitalisants, d'agents de solubilisation, de surfactants, d'agents astringents, d'agents humidifiants, d'agents adoucissants, d'agents de dispersion des rayons U.V. ou d'additifs d'épaississement) avec une ou plusieurs substances ne générant pas d'oxygène actif.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>