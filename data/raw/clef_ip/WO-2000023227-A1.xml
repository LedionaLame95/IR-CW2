="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>None</text><sources><source name="APP" created-by-npl="N"/></sources></nplcit><nplcit status="new"><text>See also references of EP     1059141A1</text><sources><source name="APP" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>KAWATA SOSAKU</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>NAKANISHI INC</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>KAWATA, SOSAKU</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>NAKANISHI INC.</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>KAWATA SOSAKU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>KAWATA, SOSAKU</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>A hand scaler polishing unit adapted to repair a hand scaler by polishing the same with a grindstone, comprising a base member having a base surface forming an angle with a horizontal plane, a member to which a grindstone is fixed, and a grindstone driving means for reciprocatingly moving the grindstone-fixed member along the base surface; and a hand scaler polishing apparatus comprising this hand scaler polishing unit, and a hand scaler fixing unit for fixing, when the polishing unit is used, the hand scaler in a substantially vertical direction.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention porte sur une unité de polissage de grattoir manuel adaptée pour réparer un grattoir à main en polissant celui-ci avec une meule à aiguiser. Cette unité de polissage comprend un élément de base doté d'une surface de base formant un angle avec un plan horizontal, un élément auquel est fixé une meule à aiguiser et un dispositif de commande de meule à aiguiser qui déplace, le long de la surface de base par un mouvement de va-et-vient, un élément fixé à la meule. L'invention porte également sur un appareil de polissage comprenant cette unité de plissage et sur une unité de fixation du grattoir manuel, ce dernier étant orienté verticalement lors de l'utilisation de l'unité de polissage.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>