atus="new" format="epo"><country>JP</country><doc-number>7298212</doc-number> <kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9046705-A" status="new"><document-id status="new" format="epo"><country>JP</country> <doc-number>9046705</doc-number> <kind>A</kind> </document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9261195-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9261195</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1069774A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>MURAKAMI YOSHIHIRO</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>SONY CORP</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>TAHARA KATSUMI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MURAKAMI, YOSHIHIRO</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>SONY CORPORATION</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>TAHARA, KATSUMI</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>MURAKAMI YOSHIHIRO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TAHARA KATSUMI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MURAKAMI, YOSHIHIRO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TAHARA, KATSUMI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>The invention relates to an encoding system for encoding input video data and to a decoding system for decoding encoded streams. Specifically, an encoded stream is accompanied in transmission so that ancillary data and information characteristic of the video data may not be lost after a number of repetitions of MPEG encoding and MPEG decoding. An MPEG encoder extracts the ancillary data attached to input video data, and transmits the extracted ancillary data together with the encoded stream by inserting the ancillary data as Ancillary_data() in the encoded stream. An MPEG decoder extracts the ancillary data from the encoded stream, and attaches the extracted ancillary data to baseband video data generated by MPEG decoding.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>Cette invention a trait à un système de codage de données vidéo en entrée ainsi qu'à un système de décodage de trains. Plus précisément, dans le cadre de ce système, un train codé est accompagné, lors de la transmission, afin d'éviter la perte de données auxiliaires et d'une caractéristique d'information des données vidéo après un certain nombre de codages et décodages MPEG répétés. Un codeur MPEG extrait les données auxiliaires attachées aux données vidéo en entrée et les transmet avec le train codé et ce, en les insérant dans ce train en tant que Ancillary data (). Un décodeur MPEG extrait les données auxiliaires du train codé et les attache aux données vidéo de bande de base produites par le décodage MPEG.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its