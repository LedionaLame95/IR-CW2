 name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-5059268-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>5059268</doc-number><kind>A</kind></document-id><sources><source category="A"  name="SEA"  created-by-npl="N"/></sources> </patcit><patcit ucid="US-4340527-A"  status="new"><document-id status="new" format="epo"><country>US</country><doc-number>4340527</doc-number><kind>A</kind></document-id> <sources><source category="A" name="SEA" created-by-npl="N"/></sources> </patcit> <patcit ucid="US-4525420-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>4525420</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="WO-1993006173-A1" status="new"><document-id status="new" format="epo"><country>WO</country><doc-number>1993006173</doc-number><kind>A1</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1123994A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>ASAHI CHEMICAL IND</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>DOI MASANORI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>YOSHIZATO AKIHIKO</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>ASAHI KASEI KOGYO KABUSHIKI KAISHA</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>DOI, MASANORI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>YOSHIZATO, AKIHIKO</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>DOI MASANORI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>YOSHIZATO AKIHIKO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>DOI, MASANORI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>YOSHIZATO, AKIHIKO</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>An elastomeric polyurethane fiber with excellent chlorine resistance containing particles which are made of a metal compound selected among the oxide and hydroxide of a metal selected from zinc and magnesium and among composite oxides of zinc and magnesium and have, adherent to the surface thereof, a treating agent selected among fatty acids, styrene/maleic anhydride copolymers, esters of the copolymers, and phosphoric ester compounds. The fiber is suitable for use as an elastomeric fibrous material for swimming suits for use in swimming pools. The fiber can be produced by spinning a polyurethane dope containing the metal compound particles having the specific treating agent adherent thereto. In this dope, the metal compound particles are inhibited from aggregating to form secondary particles. The dope enables the stable production of the modified polyurethane fiber.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention concerne une fibre de polyuréthanne élastomère, présentant une excellente résistance au chlore, contenant des particules constituées d'un composé métallique sélectionné à partir de l'oxyde et de l'hydroxyde de métal, lui-même sélectionné à partir du zinc et du magnésium et parmi des oxydes composites de zinc et de magnésium, et un agent de traitement adhérant à la surface, sélectionné parmi des acides gras, des copolymères de styrène/anhydride maléïque, des esters de copolymère, et des composés d'ester phosphorique. La fibre est conçue pour être utilisée comme matériau fibreux élastomère pour des maillots de bain utilisés dans des piscines. Cette fibre peut être produite par filage d'une solution de polyuréthanne à filer, renfermant les particules de composé métallique dont l'agent de traitement spécifique adhère à celles-ci. Dans la solution à filer, on empêche les particules de composé métallique de s'agglomérer afin qu'elles ne forment pas de particules secondaires. La solution à filer permet de produire ladite fibre de polyuréthanne modifiée stable.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>