-by-npl="N"/></sources> </patcit><patcit ucid="JP-9282263-A"  status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9282263</doc-number><kind>A</kind></document-id> <sources><source category="Y" name="SEA" created-by-npl="N"/></sources> </patcit> <patcit ucid="US-5764930-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>5764930</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>1394 TRADE ASSOCIATION, "AV/C digital interface command set", Version 1.0, 13 September 1996 (http://www.1394TA.org), XP002930125.</text><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>MIZUTANI MASAO</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>SONY CORP</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>UCHIDA YOSHIMI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MIZUTANI, MASAO</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>SONY CORPORATION</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>UCHIDA, YOSHIMI</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>MIZUTANI MASAO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>UCHIDA YOSHIMI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MIZUTANI, MASAO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>UCHIDA, YOSHIMI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>When a plurality of apparatuses are connected to a specified network, and when an apparatus connected to the network is to be recognized in order to simplify a recognition work required as when bus-resetting the apparatus connected to the network, after identifying the object apparatus, specified data obtained from the identified object apparatus is compared with specified data previously collected and stored and, when they match, the apparatus is judged to be a previously-connected apparatus to use, as the apparatus data, the data on the apparatus collected when previously connected to thereby recognizing it.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>Lorsque plusieurs installations sont connectées à un réseau déterminé et qu'il faut reconnaître une de ces installations, on peut simplifier le travail de reconnaissance, par exemple pour un nouveau réglage de bus. Après avoir identifié l'installation, on compare des données spécifiques extraites de ladite installation à des certaines données recueillies et stockées antérieurement. Lorsque les deux ensembles de données concordent, on estime que l'installation est bien celle qui était précédemment connectée.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>