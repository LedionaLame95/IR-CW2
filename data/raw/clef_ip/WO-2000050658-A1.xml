s="new" format="epo"><country>JP</country> <doc-number>5247586</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA"  created-by-npl="N"/></sources></patcit><patcit ucid="JP-8199288-A"  status="new"><document-id status="new"  format="epo"><country>JP</country><doc-number>8199288</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9013147-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9013147</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1160346A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>NIPPON STEEL CORP</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>SUEHIRO MASAYOSHI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>TAKADA YOSHIHISA</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>NIPPON STEEL CORPORATION</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>SUEHIRO, MASAYOSHI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>TAKADA, YOSHIHISA</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>SUEHIRO MASAYOSHI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TAKADA YOSHIHISA</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>SUEHIRO, MASAYOSHI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TAKADA, YOSHIHISA</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>An embodiment is a high strength alloy galvanized steel plate comprising a steel plate which has the following composition (wt %): C: 0.05 to 0.2 %, Si: 0.2 to 2.0 %, Mn: 0.2 to 2.5 %, Al: 0.01 to 1.5 %, Ni: 0.2 to 5.0 %, P: less than 0.03 %, S: less than 0.02 %, with the proviso that the contents of Si and Al satisfy the relationship: 0.4(%)&lt;/= Si+0.8Al(%) &lt;/=2.0(%), balance: Fe and inevitable impurities, has a retained austenite content of 2 to 20 volume %, and has a relationship among the contents of Ni, Si and Al contained in an uppermost surface layer of 0.5  mu m in thickness of the steel sheet satisfying the formula: Ni(%)&gt;/= 1/4Si+1/3AL(%); and, formed on the surface thereof, a Zn plating layer having an Al content of 1 % or less, the balance being Zn and inevitable impurities. A method for producing the alloy galvanized steel plate is also provided. The inventive high strength alloy galvanized steel plate is useful as members for automobiles, buildings, electric equipment and the like and is excellent especially in bulging formability in press working and in adhesion of plated metal.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>Selon une variante, l'invention concerne une plaque d'acier allié galvanisé à haute résistance comprenant une plaque d'acier dont la composition est la suivante, en poids: C: 0,05 à 0,2 %, Si: 0,2 à 2 %, Mn: 0,2 à 2,5 %, Al: 0,01 à 1,5 %, Ni: 0,2 à 5 %, P: moins de 0,03 %, S: moins de 0,02 %, à condition que les teneurs en Si et Al obéissent à la relation suivante: 0,4 (%) &lt;/= Si + 0,8Al (%) &lt;/= 2 (%). Pour le reste: Fe et impuretés inévitables. Par ailleurs, la teneur en austénite conservée est comprise entre 2 et 20 % en volume, et la relation des teneurs en Ni, Si et Al dans une couche de surface supérieure de 0,5  mu m d'épaisseur de la feuille d'acier est exprimée comme suit: Ni (%) &gt;/= 1/4Si + 1/3Al (%). On forme à la surface de ce produit une couche de placage de Zn dont la teneur en Al est inférieure ou égale à 1 %, le reste étant composé de Zn et des impuretés inévitables. L'invention concerne en outre un procédé relatif à l'élaboration de la plaque d'acier allié galvanisé à haute résistance. Ladite plaque est utile pour la fabrication d'automobiles, de bâtiments, d'équipements électriques et autres, et elle a un excellent comportement de bombement pour la mise en forme sous presse et l'adhésion des placages de métal.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>