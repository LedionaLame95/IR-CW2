ated-by-npl="N"/></sources></patcit><patcit ucid="JP-57095044-U" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>57095044</doc-number><kind>U</kind> </document-id> <sources><source category="X" name="SEA" created-by-npl="N"/></sources> </patcit><patcit ucid="JP-7231592-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>7231592</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-5780951-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>5780951</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1071187A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>IIJIMA YOSHITAKA</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>MATSUZAWA KINYA</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>SEIKO EPSON CORP</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>IIJIMA, YOSHITAKA</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MATSUZAWA, KINYA</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>SEIKO EPSON CORPORATION</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>IIJIMA YOSHITAKA</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>MATSUZAWA KINYA</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>IIJIMA, YOSHITAKA</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MATSUZAWA, KINYA</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>Inter-fitting portions formed on the ends (22b) of a stator yoke (22) and those on the ends (23b) of a magnetic core (23) are joined together in interdigitating relation to each other.  In this case, the upper projections (22b-1) of the stator yoke (22) fit in dents defined above the lower projections (23b-2) of the magnetic core (23) while the lower projections (23b-2) of the magnetic core (23) fit in dents defined below the upper projections (22b-1) of the stator yoke (22).  In this state, the stator yoke (22) and the magnetic core (23) are clamped and fixed by joining screws (24) and support legs (26).  This construction reduces the magnetic reluctance of the magnetic circuit construction and improves the power generating efficiency of the power generator using the same.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>On réunit des éléments d'assemblage, présents sur les extrémités (22b) d'une culasse de stator (22) et sur les extrémités (23b) d'un noyau magnétique (23), en relation d'interdigitation. Dans ce montage, les saillants supérieurs (22b-1) de la culasse du stator (22) s'engagent dans des dents se trouvant au-dessus des saillants inférieurs (23b-2) du noyau magnétique (23) alors que les saillants inférieurs (23b-2) du noyau magnétique (23) s'engagent dans des dents se trouvant au-dessous des saillants supérieurs (22b-1) de la culasse du stator (22). La culasse du stator (22) et le noyau magnétique sont, de ce fait, emboîtés et fixés par des vis (24) et des bras de support (26). Ce montage permet de réduire la réluctance magnétique du circuit magnétique et améliore la production d'énergie d'un générateur d'énergie équipé de ce circuit.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>