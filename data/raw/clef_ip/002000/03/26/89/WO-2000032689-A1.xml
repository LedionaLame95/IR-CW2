e="EC">B60C   1/00H</classification-symbol><classification-symbol scheme="EC">B60C  11/00</classification-symbol><classification-symbol scheme="EC">B60C  11/14</classification-symbol><classification-symbol scheme="EC">C08K   3/22+L21/00</classification-symbol><classification-symbol scheme="EC">C08K   7/02+L21/00</classification-symbol><classification-symbol scheme="EC">C08K   7/22+L21/00</classification-symbol><classification-symbol scheme="EC">C08L  21/00+B2</classification-symbol></classification-ecla><invention-title load-source="docdb" status="new" lang="EN">RUBBER COMPOSITION FOR TIRE TREAD HAVING IMPROVED RUNNING PERFORMANCE ON ICE AND PNEUMATIC TIRE USING THE SAME</invention-title><invention-title load-source="docdb" status="new" lang="FR">COMPOSITION DE CAOUTCHOUC POUR SCULPTURE DE PNEU A PERFORMANCES DE ROULEMENT AMELIOREES SUR ROUTES VERGLACEES ET PNEUMATIQUE A BASE DE CELLE-CI</invention-title><citations><patent-citations><patcit ucid="JP-10316801-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>10316801</doc-number><kind>A</kind></document-id><sources><source category="XP" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-4117439-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>4117439</doc-number><kind>A</kind></document-id><sources><source category="Y"  name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-59196328-A" status="new"><document-id status="new" format="epo"><country>JP</country> <doc-number>59196328</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA"  created-by-npl="N"/></sources></patcit> <patcit ucid="JP-9012770-A"  status="new"><document-id status="new"  format="epo"><country>JP</country> <doc-number>9012770</doc-number> <kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9012778-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9012778</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-5591279-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>5591279</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1052270A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>AMINO NAOYA</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>YAMAGUCHI YOICHI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>YOKOHAMA RUBBER CO LTD</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>AMINO, NAOYA</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>THE YOKOHAMA RUBBER CO., LTD.</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>YAMAGUCHI, YOICHI</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>AMINO NAOYA</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>YAMAGUCHI YOICHI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>AMINO, NAOYA</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>YAMAGUCHI, YOICHI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>A rubber composition for a tire tread exhibiting high friction force on ice, which comprises a diene rubber, a carbon black and/or silica and a thermoplastic resin having a gas encapsulated therein, and optionally, further comprises short fibers, hard particles and/or a liquid polymer, wherein a thermoplastic resin having a gas encapsulating therein is incorporated into the composition by a method comprising expanding, prior to curing the rubber, heat-expandable thermoplastic resin particles composed of a thermoplastic resin having a starting temperature for heat expansion of 70  DEG C or higher and lower than 120  DEG C and showing the heat resistance sufficient to withstand the curing of the rubber composition through heating it to a temperature above the starting temperature for heat expansion, and then curing the rubber, to thereby disperse the thermoplastic resin particles uniformly into the rubber; and a pneumatic tire using the composition for the tread thereof.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>La présente invention concerne une composition de caoutchouc destinée à une sculpture de pneu présentant des forces de frottement élevées sur le verglas. Cette composition renferme du caoutchouc diénique, du noir de carbone et/ou de la silice et une résine thermoplastique contenant du gaz encapsulé, et éventuellement, des fibres courtes, des particules dures et/ou un polymère liquide. Dans cette composition, on incorpore une résine thermoplastique contenant du gaz encapsulé selon un procédé consistant à dilater, avant de faire cuire le caoutchouc, les particules thermoexpansibles de résine thermoplastique composées d'une résine thermoplastique présentant une température de démarrage pour l'expansion thermique comprise entre 70  DEG C et 120  DEG C, et présentant une résistance thermique suffisante pour supporter la cuisson de la composition de caoutchouc effectuée lors de son chauffage à une température au-dessus de la température de démarrage pour l'expansion thermique. Ce procédé consiste ensuite à faire cuire le caoutchouc afin de disperser les particules de résine thermoplastique uniformément dans le caoutchouc. Par ailleurs, cette invention concerne un pneumatique utilisant la composition de cette sculpture.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>