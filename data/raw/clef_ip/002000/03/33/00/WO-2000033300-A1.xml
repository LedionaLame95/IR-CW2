NJI, MASARU</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>ISAKA, HARUO</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MATSUSHITA ELECTRIC INDUSTRIAL CO., LTD.</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MUKAE, HIDEAKI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>UMEE, KAZUNORI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>YOHDA, HIROSHI</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>BABA KOUHEI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>HIGASHIONJI MASARU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>ISAKA HARUO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>MUKAE HIDEAKI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>UMEE KAZUNORI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>YOHDA HIROSHI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>BABA, KOUHEI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>HIGASHIONJI, MASARU</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>ISAKA, HARUO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MUKAE, HIDEAKI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>UMEE, KAZUNORI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>YOHDA, HIROSHI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>A loading detector used for a VTR to check the recording state of a recording head without using the reproducing head. A test signal (5) of a lower frequency than the erasing frequency is recorded before and after an information signal (2) by means of an erasing head (4). Before and after recording the information signal (2) by means of the recording head (3), the test signal (5) is reproduced, the reproduction output is detected by a detecting circuit (10), and the level of the output is compared with a preset level by a comparing circuit (11). When the level is lower than the preset level, a warning is issued from a warning circuit (15), thus preventing a recording failure due to the loading of the head.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention porte sur un détecteur de chargement pour magnétoscope vérifiant l'état de la tête d'enregistrement sans utiliser la tête de lecture. Un signal test,de fréquence inférieure à celle de la fréquence d'effacement, est enregistré avant et après un signal (2) d'information à l'aide d'une tête (4) d'effacement. Avant et après l'enregistrement du signal (2) d'information à l'aide de la tête d'enregistrement (3), on reproduit le signal (5) test et les signaux de reproduction sont comparés à un niveau préétabli par un circuit de comparaison (11). Lorsque le niveau est inférieur au niveau préétabli, une alarme émise par un circuit (15) d'alarme empêche les erreurs d'enregistrement dues au chargement de la tête.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>