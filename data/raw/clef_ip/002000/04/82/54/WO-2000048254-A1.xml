cument-id status="new" format="epo"><country>EP</country> <doc-number>0874405</doc-number><kind>A2</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit> <patcit ucid="JP-5243614-A" status="new"><document-id status="new"  format="epo"><country>JP</country> <doc-number>5243614</doc-number> <kind>A</kind></document-id><sources><source category="A"  name="SEA"  created-by-npl="N"/></sources></patcit><patcit ucid="JP-8064791-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>8064791</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9083016-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9083016</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9180998-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9180998</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1184913A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit><nplcit status="new"><text>SHUJI NAKAMURA ET AL.: 'High power, long-lifetime InGaN/GaN/A1GaN-based laser diodes grown on pure GaN substrates' JAPANESE JOURNAL OF APPLIED PHYSICS vol. 37, 1998, pages L309 - L312, XP002932562</text><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>NICHIA CORP</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>NICHIA CORPORATION</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>NAGAHAMA SHINICHI</name></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>NAKAMURA SHUJI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>NAGAHAMA, SHINICHI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>NAKAMURA, SHUJI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>On a GaN substrate (30) having a monocrystalline GaN layer on its surface, device forming layers made of nitride semiconductor are formed. The coefficient of thermal expansion of the device forming layer (1) in contact with the GaN substrate (30) is made smaller than that of GaN, and thereby compressive strain is applied to the device forming layer (1). Cracks which may occur in the device forming layer are suppressed, and thus a nitride semiconductor device having good characteristics is produced.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>Sur un substrat GaN (30) pourvu superficiellement d'une couche de GaN monocristallin, on forme des couches de formation de dispositif faites de nitrure semi-conducteur. Le coefficient de dilatation thermique de la couche de formation de dispositif (1) en contact avec le substrat GaN (30) est rendu inférieur à celui du GaN, ce qui permet l'application d'une contrainte en compression sur la couche de formation de dispositif (1). On évite ainsi la formation de craquelures dans la couche de formation de dispositif, ce qui, par conséquent, permet la production d'un dispositif semi-conducteur présentant de bonnes caractéristiques.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>