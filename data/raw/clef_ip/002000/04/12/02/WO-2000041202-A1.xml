ountry>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>FUSHIMI MASAHIRO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>MITSUHASHI TAKAO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>MURATA SHIRO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TAKAHASHI MITSUGU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TSUKIMA MITSURU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>YAMAGATA SHINJI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>FUKUYA, KAZUNORI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>FUSHIMI, MASAHIRO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MITSUHASHI, TAKAO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MURATA, SHIRO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TAKAHASHI, MITSUGU</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TSUKIMA, MITSURU</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>YAMAGATA, SHINJI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>A current limiter having an excellent current-limiting function and produced at low cost and a circuit breaker comprising the same and having a small impedance are provided so as to prevent the case from being damaged because of an unwanted increase of the pressure inside the case due to an arc. Contactors (1, 7) have respective contacts. When the contacts are in contact with each other, the ends on the contacts' side are in a cylindrical space in a cylindrical insulator (25); when the contacts are out of contact,  one of the contacts is outside the cylindrical space. If an arc is produced, the pressure in acylindrical space (18) is abruptly increased to decrease the arc current, thus improving the current limiting performance.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>Cette invention concerne un limiteur de courant très efficace, au coût de fabrication réduit, intégré à un disjoncteur de faible impédance, l'ensemble protégeant le boîtier contre une augmentation accidentelle de la pression interne provoquée par un arc. Lorsque les contacts des contacteurs (1 7) se touchent, les extrémités latérales des contacts se trouvent dans l'espace cylindrique d'un isolant cylindrique (25); Lorsque les contacts ne se touchent pas, l'un des contacts se trouve hors de l'espace cylindrique. Si un arc se produit, la pression dans l'espace cylindrique (18) augmente brusquement, ce qui provoque une baisse du courant générateur d'arc et améliore la fonction limitatrice de courant.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>