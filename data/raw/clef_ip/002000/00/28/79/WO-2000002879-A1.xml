y>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>MOCHIDA KENICHI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>NAGATA HIROYUKI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>SAITOH YUTAKA</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TAKAHASHI ISAMI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>UE HARUMI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>AKAMA, TSUTOMU</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>HASEGAWA, ATSUHIRO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>IKEDA, SHUN-ICHI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>KANDA, YUTAKA</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MOCHIDA, KENICHI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>NAGATA, HIROYUKI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>SAITOH, YUTAKA</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TAKAHASHI, ISAMI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>UE, HARUMI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>LK6-A derivatives represented by general formula (I) and pharmacologically acceptable salts thereof, which exhibit immunosuppressive, cytostatic and antitumor effects and so on, wherein R&lt;1&gt; is a lower alkanoyl or acryloyl group which may be substituted with, e.g., lower alkoxy, or the like; R&lt;2&gt; is hydrogen, halogeno or the like; R&lt;2'&gt; is hydrogen, or R&lt;2'&gt; together with R&lt;3&gt; forms a bond; R&lt;3&gt; is optionally substituted lower alkanoyl, or R&lt;3&gt; together with R&lt;2'&gt; forms a bond; R&lt;4&gt; and R&lt;5&gt; are each hydrogen, optionally substituted lower alkanoyl or the like; R&lt;6&gt; is hydrogen or the like; and R&lt;7&gt; and R&lt;8&gt; are each hydrogen, optionally substituted lower alkanoyl or the like, with the proviso that LK6-A corresponding to a compound of general formula (I) where R&lt;1&gt; is (E)-methoxyacryloyl; R&lt;2&gt;, R&lt;4&gt;, R&lt;5&gt;, R&lt;6&gt; and R&lt;7&gt; are each hydrogen; R&lt;8&gt; is acetyl; and R&lt;2'&gt; and R&lt;3&gt; together form a bond is excepted.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention concerne des dérivés de LK6-A représentés par la formule générale (I) et des sels pharmacologiquement acceptables de ceux-ci, qui possèdent des effets immunosuppresseurs, cytostatiques et antitumoraux, etc. Dans la formule, R&lt;1&gt; est un groupe alcanoyle ou acryloyle inférieur pouvant être substitué par, p. ex., un alkoxy inférieur ou analogue; R&lt;2&gt; est hydrogène, halogéno ou analogue; R&lt;2'&gt; est hydrogène, ou R&lt;2'&gt; et R&lt;3&gt; forment ensemble une liaison; R&lt;3&gt; est un alcanoyle inférieur éventuellement substitué, ou R&lt;3&gt; et R&lt;2'&gt; forment ensemble une liaison; R&lt;4&gt; et R&lt;5&gt; sont chacun hydrogène, un alcanoyle inférieur éventuellement substitué ou analogue; R&lt;6&gt; est hydrogène ou analogue; et R&lt;7&gt; et R&lt;8&gt; sont chacun hydrogène, un alcanoyle inférieur éventuellement substitué ou analogue, à condition que LK6-A corresponde à un composé représenté par la formule générale (I), dans laquelle R&lt;1&gt; est (E)-méthoxyacryloyle; R&lt;2&gt;, R&lt;4&gt;, R&lt;5&gt;, R&lt;6&gt; et R&lt;7&gt; sont chacun hydrogène; R&lt;8&gt; est acétyle; et R&lt;2'&gt; et R&lt;3&gt; ne forment pas une liaison.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>