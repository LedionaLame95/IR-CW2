egory="Y"  name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-7214893-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>7214893</doc-number><kind>A</kind> </document-id> <sources><source category="Y" name="SEA" created-by-npl="N"/></sources> </patcit><patcit ucid="JP-9202042-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9202042</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1018439A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>HIBINO YOSHIHIKO</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>IDEI KOJI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>MITSUBISHI PAPER MILLS LTD</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>HIBINO, YOSHIHIKO</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>IDEI, KOJI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MITSUBISHI PAPER MILLS LIMITED</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>HIBINO YOSHIHIKO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>IDEI KOJI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>HIBINO, YOSHIHIKO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>IDEI, KOJI</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>An ordinary type paper for use in both ink-jet recording and electrophotographic recording which comprises a supporting material and a cationic resin coated thereon in an amount of 0.5 to 2.0 g/m&lt;2&gt; in terms of the amount of a dried resin, and has a surface resistivity of 1.0 x 10&lt;9&gt; to 9.9 x 10&lt;13&gt;  OMEGA . It is preferred that the cationic resin has a cationic equivalent of 3 to 8 meq/g as measured by the colloidal titration method and that the internal sizing agent used in the supporting material is a neutral rosin sizing agent or an alkenyl succinic anhydride. The supporting material may contain a pulp from waste paper. This paper for use in both ink-jet recording and electrophotographic recording is excellent with respect to the water resistance of an image in ink-jet recording and also excellent in toner transfer characteristics and carrying characteristics in electrophotographic recording.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention concerne un papier de type ordinaire utilisé à la fois pour une impression par jet d'encre et pour une impression électrophotographique, comprenant un matériau de support et une résine cationique recouverte de 0,5 à 2,0 g/m&lt;2&gt; de résine sèche et possédant une résistivité en surface de 1,0 x 10&lt;9&gt; à 9,9 x 10&lt;13&gt;  OMEGA . Il est préférable que la résine cationique possède un équivalent cationique de 3 à 8 meq/g, mesuré par la méthode de titration colloïdale, et que l'agent de collage interne utilisé dans le matériau de support soit un agent neutre de collage à la colophan, ou un anhydre succinique alcényle. Le matériau de support peut contenir une pâte provenant de déchets de papier. Ce papier utilisé à la fois pour une impression par jet d'encre et pour une impression électrophotographique présente une excellente résistance à l'eau en ce qui concerne une image imprimée par jet d'encre, une excellent aptitude au transfert de toner, et une bonne aptitude aux fonctions de support dans une impression électrophotographique.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>