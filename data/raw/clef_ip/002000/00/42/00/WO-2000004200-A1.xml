ntry>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>TOMOKIYO TOSHIMASA</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>MARUTA, RYO</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>NIPPON STEEL CORPORATION</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>TANIGUCHI, HIROKAZU</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>TOMOKIYO, TOSHIMASA</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>MARUTA RYO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TANIGUCHI HIROKAZU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>TOMOKIYO TOSHIMASA</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>MARUTA, RYO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TANIGUCHI, HIROKAZU</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TOMOKIYO, TOSHIMASA</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p> A high-strength steel plate characterized by comprising 0.01 to 0.15 wt.% carbon, 0.005 to 1.0 wt.% silicon, 0.1 to 2.2 wt.% manganese, 0.001 to 0.06 wt.% phosphorus, 0.001 to 0.01 wt.% sulfur, 0.0005 to 0.01 wt.% nitrogen, 0.001 to 0.10 wt.% aluminum, 0.005 to 0.05 wt.% niobium, 0.05 to 0.5 wt.% molybdenum, and iron as the main component, optionally containing 0.001 to 0.02 wt.% titanium, 0.2 to 2.0 wt.% copper, and 0.05 to 2.0 wt.% nickel, and satisfying the following relationship (A): 0.22 &gt;/= C(%) + (Si/30)(%) + (Mn/20)(%) + (Mo/15)(%). It is excellent in fatigue properties and moldability after welding, and can have a weld heat-affected zone which is less apt to have softened.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>La présente invention concerne une tôle d'acier, de tenue mécanique élevée, caractérisée en ce qu'elle contient de 0,01 à 0,15 % en poids de carbone, 0,005 à 1,0 % en poids de silicium, 0,1 à2,2 % en poids de manganèse, 0,001 à 0,06 % en poids de phosphore, 0,001 à 0,01 % en poids de soufre, 0,0005 à 0,01 % en poids d'azote, 0,001 à 0,10 % en poids d'aluminium, 0,005 à 0,05 % en poids de niobium, 0,05 à 0,5 % en poids de molybdène, et du fer comme constituant principal, et contenant éventuellement 0,001 à 0,02 % en poids de titane, 0,2 à 2,0 % en poids de cuivre et 0,05 à 2,0 % en poids de nickel, en satisfaisant à la relation (A): C(%) + (Si/30)(%) + (Mn/20)(%) + (Mo/15)(%) &lt;/= 0,22. Cette tôle d'acier présente, après soudage, d'excellentes propriétés de résistance à la fatigue et d'aptitude au moulage, et elle est moins apte à l'adoucissement dans les zones de soudage affectées par la chaleur.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>