ry="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9209627-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9209627</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-3854310-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>3854310</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-4454776-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>4454776</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-4949563-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>4949563</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-5713613-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>5713613</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="WO-1991000405-A1" status="new"><document-id status="new" format="epo"><country>WO</country><doc-number>1991000405</doc-number><kind>A1</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1167663A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>LUO SHIZHONG</name><address><country>CN</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>LUO, SHIZHONG</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>LUO SHIZHONG</name><address><country>CN</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>LUO, SHIZHONG</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>An electric motor-driven locking device for a lock, which comprises a lock housing (2), a micromotor (17), a worm gear (13) and a worm wheel (5), a pin (6), a latch (10), a swinging engagement member (2), a tension spring (4), the member (2) and the tension spring (4) are mounted on the lock housing (2) near the worm wheel (5) by way of the bearing pin (3), the pin (6) is secured on the surface of the worm wheel, the engaging end of the member (2) engages the corresponding portion of the latch (10), the other end of the member (2) forming a pin contacting portion (12), which is provided on the relative moving track of the pin (6), so that when the portion (12) is contacting the pin (6), it rotates due to the attack by the pin (6), thus the engaging end of the member (2) is left off the corresponding portion of the latch (10).</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>L'invention concerne une serrure commandée par un moteur électrique se composant d'un boîtier (1), d'un micromoteur (17), d'une vis sans (13) et d'une roue hélicoïdale (5), d'un axe (6), d'un loquet de verrouillage (10), d'un levier (2) et d'un ressort (4), ces deux derniers étant disposés par l'intermédiaire d'un axe de verrouillage (3) sur le boîtier (1) à proximité de la roue hélicoïdale (5) et l'axe (6) étant, quant à lui, placé sur la surface de la roue hélicoïdale (5). L'extrémité du levier (2) entre en contact avec la partie correspondante du loquet (10) alors que l'autre extrémité du levier (2) forme une partie de contact (12) de l'axe qui se trouve sur la tige mobile de l'axe (6) de manière que lorsque la partie (12) est en contact avec l'axe (6), elle tourne ce qui a pour effet de retirer l'extrémité de contact du levier (2) de la partie correspondante du loquet (10).</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>