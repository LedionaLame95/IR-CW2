ory="XE" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-5850102-A"  status="new"><document-id status="new" format="epo"><country>US</country><doc-number>5850102</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="WO-1998021745-A1" status="new"><document-id status="new"  format="epo"><country>WO</country><doc-number>1998021745</doc-number><kind>A1</kind></document-id><sources><source category="A"  name="SEA"  created-by-npl="N"/></sources></patcit><patcit ucid="WO-1998021748-A1" status="new"><document-id status="new" format="epo"><country>WO</country> <doc-number>1998021748</doc-number><kind>A1</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit> </patent-citations> <non-patent-citations><nplcit status="new"><text>See also references of EP     1191582A1</text> <sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>KATO YOSHIHIRO</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>KOBAYASHI TAKASHI</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>TOKYO ELECTRON LTD</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="epo"><addressbook><name>YOSHITAKA HIKARU</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>KATO, YOSHIHIRO</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>KOBAYASHI, TAKASHI</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>TOKYO ELECTRON LIMITED</name></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>YOSHITAKA, HIKARU</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>KATO YOSHIHIRO</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>KOBAYASHI TAKASHI</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="epo"><addressbook><name>YOSHITAKA HIKARU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>KATO, YOSHIHIRO</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>KOBAYASHI, TAKASHI</name></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>YOSHITAKA, HIKARU</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>An inorganic insulation film (103) consisting of SiC is formed on a fluoride-added carbon film (102) by a chemical vapor growth method using SiF4 and C2H4 as a source gas. Use of SiF4 and CF4 not containing hydrogen (H) as a source gas can prevent H from being brought into the inorganic insulation film (103) forming a hard mask (113); therefore, H diffused outward from the inorganic film (103) combines with fluorine (F) in the fluorine-added carbon film (102) to form HF, which HF prevents the corrosion of the inorganic film (103) and the like. Accordingly, adhesiveness between the hard mask (113) formed of the inorganic insulation film (103) and another layer such as the fluorine-added carbon film (102) can be prevented from deteriorating.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>Selon cette invention, un film isolant inorganique (103) constitué de SiC est formé sur un film carbone au fluor (102) par procédé de croissance chimique en phase vapeur utilisant SiF4 et C2H4 comme gaz source. L'utilisation comme gaz source de SiF4 et de CF4 ne contenant pas d'hydrogène (H) permet d'empêcher H de pénétrer dans le film isolant inorganique (103) formant un masque dur (104); de cette manière, H diffusé vers l'extérieur depuis le film isolant inorganique (103) se combine au fluor (F) dans le film carbone au fluor (102) pour former HF. HF empêche la corrosion du film inorganique (103) et similaire. Ainsi, il est possible d'éviter la diminution de l'adhérence entre le masque dur (113) formé sur le film isolant inorganique (103) et une autre couche telle que le film carbone au fluor (102).</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>