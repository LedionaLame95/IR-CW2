 category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-61009570-A" status="new"><document-id status="new"  format="epo"><country>JP</country><doc-number>61009570</doc-number><kind>A</kind> </document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-62222437-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>62222437</doc-number> <kind>A</kind> </document-id> <sources><source category="A"  name="SEA"  created-by-npl="N"/></sources></patcit><patcit ucid="JP-63003406-A"  status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>63003406</doc-number><kind>A</kind></document-id><sources><source category="Y" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-7090565-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>7090565</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="JP-9147348-A" status="new"><document-id status="new" format="epo"><country>JP</country><doc-number>9147348</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit><patcit ucid="US-5557313-A" status="new"><document-id status="new" format="epo"><country>US</country><doc-number>5557313</doc-number><kind>A</kind></document-id><sources><source category="A" name="SEA" created-by-npl="N"/></sources></patcit></patent-citations><non-patent-citations><nplcit status="new"><text>See also references of EP     1103625A1</text><sources><source name="SEA" created-by-npl="N"/></sources></nplcit></non-patent-citations></citations></technical-data><parties><applicants><applicant status="new" format="epo"><addressbook><name>TAKAHASHI MIGAKU</name><address><country>JP</country></address></addressbook></applicant><applicant status="new" format="intermediate"><addressbook><name>TAKAHASHI, MIGAKU</name></addressbook></applicant></applicants><inventors><inventor status="new" format="epo"><addressbook><name>TAKAHASHI MIGAKU</name><address><country>JP</country></address></addressbook></inventor><inventor status="new" format="intermediate"><addressbook><name>TAKAHASHI, MIGAKU</name></addressbook></inventor></inventors></parties></bibliographic-data><abstract load-source="docdb" source="national office" status="new" lang="EN"><p>A magnetic alloy comprising cobalt (Co), chromium (Cr), and germanium (Ge) as main components and having a composition represented by CoxCryGez wherein x, y and z represent composition ratios in atom % and satisfy the formulae: 78 &lt;/= x &lt;/= 87, 2.5 &lt;/= y &lt;/= 14.5, 3.5 &lt;/= z &lt;/= 15 and x + y + z = 100. Further, a magnetic alloy comprising Co, Cr, Ge and T, wherein T represents one or more of Ta, Si, Nb, B, Ni and Pt, and a magnetic alloy comprising Co, Cr, Ge and T', wherein T' represents one or more of Ta, B, and Pt, each alloy having a specific composition, are also disclosed. The magnetic alloy and a target comprising the alloy have a high normalized coercive force and can be used for producing a magnetic recording medium having a magnetic film exhibiting reduced disturbance by heat and having thermally stable magnetic properties.</p></abstract><abstract load-source="docdb" source="national office" status="new" lang="FR"><p>La présente invention concerne un alliage magnétique contenant du cobalt (Co), du chrome (Cr) et du germanium (Ge) comme principaux composants, la formule de celui-ci étant représentée par CoxCryGez, dans laquelle x, y et z représentent les rapports de composition en pourcentage d'atome correspondent à la formule suivante: 78 &lt;/= x &lt;/= 87, 2,5 &lt;/= y &lt;/= 14,5, 3,5 &lt;/= z &lt;/= 15 et x + y + z = 100. Par ailleurs, cette invention concerne un alliage magnétique contenant Co, Cr, Ge et T, dans lequel T représente Ta, et/ou Si, et/ou Nb, et/ou B, et/ou Ni et/ou Pt, et un alliage magnétique contenant Co, Cr, Ge et T', dans lequel T' représente Ta, et/ou B, et/ou Pt, chaque alliage présentant une composition spécifique. L'alliage magnétique et la cible contenant l'alliage possèdent une force coercitive normalisée élevée et peuvent être utilisés pour produire un support d'enregistrement magnétique à film magnétique présentant des propriétés magnétiques thermiquement stables.</p></abstract><copyright>User acknowledges that the Information Retrieval Facility (IRF) and its third party providers retain all right, title and interest in and to this xml under applicable copyright laws. User acquires no ownership rights to this xml including but not limited to its format. User hereby accepts the terms and conditions of the Licence Agreement set forth at http://www.ir-facility.org/legal/marec/data_licence</copyright></patent-document>